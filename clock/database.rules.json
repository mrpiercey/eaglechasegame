{
  "rules": {
    "race": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'donald.piercey@gmail.com'"
    },
    "runners": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'donald.piercey@gmail.com'"
    },
    "finishes": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'donald.piercey@gmail.com' || root.child('staff').child(auth.uid).exists())"
    },
    "staff": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'donald.piercey@gmail.com'"
    },
    "requests": {
      ".read": "auth != null && auth.token.email == 'donald.piercey@gmail.com'",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'donald.piercey@gmail.com')"
      }
    }
  }
}
